rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function isUserDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function isAdmin() {
      return isSignedIn() && isUserDocExists() && getUserDoc().data.role == 'admin' && getUserDoc().data.enabled == true;
    }
    
    function isStaff() {
      return isSignedIn() && isUserDocExists() && (getUserDoc().data.role == 'admin' || getUserDoc().data.role == 'staff') && getUserDoc().data.enabled == true;
    }

    // 1. Users profiles
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && (
        incoming().role == 'viewer' || 
        (incoming().role == 'admin' && request.auth.token.email == 'paulsam1020@gmail.com')
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId && !incoming().diff(existing()).affectedKeys().hasAny(['role', 'enabled', 'email', 'uid']))
      );
      allow delete: if false;
    }

    // 2. Products
    match /products/{productId} {
      allow read: if true;
      allow write, create, update, delete: if isStaff();
    }

    // 3. Day Type Templates
    match /dayTypeTemplates/{templateId} {
      allow read: if true;
      allow write, create, update, delete: if isStaff();
    }

    // 4. Meal Plans
    match /mealPlans/{planCode} {
      allow read: if true;
      allow create: if true;
      allow update: if isStaff() || (incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt']));
      allow delete: if isStaff();
    }

    // 5. Meal Plan Days Subcollection
    match /mealPlans/{planCode}/days/{dayId} {
      allow read: if true;
      allow create: if true;
      allow update: if exists(/databases/$(database)/documents/mealPlans/$(planCode));
      allow delete: if isStaff();
    }

    // 6. Meal Plan Scoped Templates Subcollection
    match /mealPlans/{planCode}/templates/{templateId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isStaff();
    }
  }
}
